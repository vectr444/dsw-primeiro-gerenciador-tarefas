# Copie este arquivo para ".env" (na raiz do projeto) e preencha.
# O ".env" NUNCA vai para o Git (está no .gitignore); este ".env.example" vai.
#
# Salve o .env em UTF-8 SEM BOM (no VS Code: barra de status > "UTF-8").
# Sem TURSO_URL e TURSO_TOKEN o servidor usa o arquivo local tarefas.db.

# Banco na nuvem (Turso): copie do painel, sem barra "/" no final
TURSO_URL=
TURSO_TOKEN=

# Segredo que assina os tokens JWT (no Render ele é gerado automaticamente)
JWT_SECRET=

# Porta do servidor (opcional; o padrão é 3000)
# PORT=3000
