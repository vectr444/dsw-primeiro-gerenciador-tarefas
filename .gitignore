# ---------------------------------------------------------------------------
# Gerenciador de Tarefas (back-end Node/Express + front React/Vite)
# Este .gitignore vale para a raiz e para a pasta web/.
# ---------------------------------------------------------------------------

# Dependencias (instaladas com "npm install" na raiz e em web/)
node_modules/

# Build / saida compilada
dist/
dist-ssr/
*.tsbuildinfo

# Banco de dados SQLite (e arquivos auxiliares e copias de seguranca)
# O tarefas.db e recriado pelo server.ts quando nao existe.
*.db
*.db-journal
*.db-wal
*.db-shm
*.db.bak
*.sqlite
*.sqlite3

# Variaveis de ambiente (podem conter segredos, ex.: JWT_SECRET)
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Cache de ferramentas
.eslintcache
.vite/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.cache/
.npm
coverage/

# Editores e sistema operacional
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
Desktop.ini

# Arquivos temporarios / backups manuais
*.bak
*.tmp
*.local
